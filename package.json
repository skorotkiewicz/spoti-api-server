{
  "name": "spoti-browser-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Spotify API backed only by browser interaction",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "login": "node dist/src/main.js login",
    "setup": "./setup.sh",
    "tui": "npm run build && node dist/src/tui.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": { "puppeteer-core": "^24.0.0" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.9.3" }
}
